	setAttr ".ixp" -type "string" ".O[0] = .I[0]*((noise((2+0.5*(time*(.I[1])+(.I[2]/24)))/.I[3])*.I[4])*(.I[5]));\n.O[1]=.I[0]*((noise(1.1*(time*(.I[1]-1)+(.I[2]/24)))-.5)*((.I[6]/10)*(.I[5])));\n.O[2]=.I[0]*((1.3*(noise(time*(.I[1]+1)+(.I[2]/24))-.5)*(.I[7]/10))*(.I[5]));";
createNode unitConversion -n "Cam_rig:Cam_rig:shotcam_unitConversion1";
	rename -uid "E4DFF9A2-4B70-C7F2-7FB4-559891C4D777";
	setAttr ".cf" 0.017453292519943295;
createNode expression -n "Cam_rig:Cam_rig:shotcam_expr_Overlay";
	rename -uid "CE2236B6-4271-61A2-EC0F-029D6D1C56F3";
	setAttr -k on ".nds";
	setAttr -s 8 ".in";
	setAttr -s 8 ".in";
	setAttr -s 6 ".out";
	setAttr ".ixp" -type "string" (
		"float $cnvunit_focal = 0.1 ;\nfloat $cnvunit_film = 2.54 ;\nfloat $offset = 0 ;\n\nfloat $pos = .I[0] * $cnvunit_focal ;\nif ($pos < .I[1]) $offset =  .I[1] * 1.05 - $pos  ;\n\n.O[0] = -$pos - $offset ;\n.O[3] = .O[2] = .O[1] = (.O[0] / -$pos ) * .I[2];\n\n.O[4] = .I[3] * $cnvunit_film ;\n.O[5] = .I[4] * $cnvunit_film ;\n\nfloat $ratio_film = .I[3]  / .I[4]  ;\nfloat $ratio_res = .I[5] / .I[6] ;\n\nfloat $scale_h = .I[3] * $cnvunit_film ;\nfloat $scale_v = .I[4] * $cnvunit_film ;\nint $fitmode = .I[7] ;\n\n// if same ratios, easy\nif ($ratio_res == $ratio_film) {\n\t.O[4] = $scale_h ;\n\t.O[5] = $scale_v ;}\n\nelse {\n    // process fill mode\n    if ($fitmode == 0) {\n        if ($ratio_res < $ratio_film) $fitmode = 2 ;\n        else if ($ratio_res > $ratio_film) $fitmode = 1 ;}\n    \n    // process overscan mode\n    else if ($fitmode == 3) {\n        if ($ratio_res > $ratio_film) $fitmode = 2 ;\n        else if ($ratio_res < $ratio_film) $fitmode = 1 ;}\n    \n    if ($fitmode == 1) {\n        .O[4] = $scale_h ;\n        .O[5] = $scale_h / $ratio_res ;}\n"
		+ "    \n    else if ($fitmode == 2) {\n        .O[4] = $scale_v * $ratio_res ;\n        .O[5] = $scale_v ;}\n    }");

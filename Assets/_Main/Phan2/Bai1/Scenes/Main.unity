  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f401e5be15a426d49908ab43e6b8d1cb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tableName: Table
  isMale: 1
  maleQuestions:
  - questionKey: 1
    answerKeys:
    - 1a
    - 1b
    - 1c
    - 1d
    question: "C\xE2u 1 :Trong gi\u1EA3i ph\u1EABu h\u1EC7 sinh d\u1EE5c nam, tinh
      tr\xF9ng sau khi \u0111\u01B0\u1EE3c sinh ra t\u1EA1i tinh ho\xE0n s\u1EBD
      \u0111\u01B0\u1EE3c di chuy\u1EC3n \u0111\u1EBFn c\u1EA5u tr\xFAc n\xE0o \u0111\u1EC3
      ti\u1EBFp t\u1EE5c ho\xE0n thi\u1EC7n v\xE0 d\u1EF1 tr\u1EEF?"
    answers:
    - "T\xFAi tinh"
    - "M\xE0o tinh"
    - "\u1ED0ng d\u1EABn tinh"
    - "Tuy\u1EBFn ti\u1EC1n li\u1EC7t"
    correctIndex: 1
  - questionKey: 2
    answerKeys:
    - 2a
    - 2b
    - 2c
    - 2d
    question: "C\xE2u 2 :Tuy\u1EBFn ti\u1EC1n li\u1EC7t n\u1EB1m \u1EDF v\u1ECB tr\xED
      n\xE0o so v\u1EDBi b\xE0ng quang?"
    answers:
    - " N\u1EB1m ngay ph\xEDa tr\xEAn b\xE0ng quang"
    - "N\u1EB1m ngay ph\xEDa d\u01B0\u1EDBi c\u1ED5 b\xE0ng quang"
    - "N\u1EB1m ph\xEDa sau tr\u1EF1c tr\xE0ng"
    - "N\u1EB1m ph\xEDa tr\u01B0\u1EDBc x\u01B0\u01A1ng mu"
    correctIndex: 1
  - questionKey: 3
    answerKeys:
    - 3a
    - 3b
    - 3c
    - 3d
    question: "C\xE2u 3 :\u1ED0ng ph\xF3ng tinh \u0111\u01B0\u1EE3c h\xECnh th\xE0nh
      b\u1EDFi s\u1EF1 k\u1EBFt h\u1EE3p c\u1EE7a hai c\u1EA5u tr\xFAc n\xE0o?"
    answers:
    - "\u1ED0ng d\u1EABn tinh v\xE0 \u1ED1ng ti\u1EBFt c\u1EE7a t\xFAi tinh"
    - "\u1ED0ng d\u1EABn tinh v\xE0 ni\u1EC7u \u0111\u1EA1o"
    - " M\xE0o tinh v\xE0 \u1ED1ng d\u1EABn tinh"
    - "T\xFAi tinh v\xE0 tuy\u1EBFn ti\u1EC1n li\u1EC7t"
    correctIndex: 0
  - questionKey: 4
    answerKeys:
    - 4a
    - 4b
    - 4c
    - 4d
    question: "C\xE2u 4 :\u0110o\u1EA1n ni\u1EC7u \u0111\u1EA1o n\xE0o \u1EDF nam
      gi\u1EDBi \u0111i xuy\xEAn qua tuy\u1EBFn ti\u1EC1n li\u1EC7t?"
    answers:
    - "Ni\u1EC7u \u0111\u1EA1o m\xE0ng"
    - "Ni\u1EC7u \u0111\u1EA1o x\u1ED1p"
    - " Ni\u1EC7u \u0111\u1EA1o ti\u1EC1n li\u1EC7t"
    - "Ni\u1EC7u \u0111\u1EA1o tr\u01B0\u1EDBc"
    correctIndex: 2
  - questionKey: 5
    answerKeys:
    - 5a
    - 5b
    - 5c
    - 5d
    question: "C\xE2u 5 :C\u1EA5u tr\xFAc n\xE0o sau \u0111\xE2y thu\u1ED9c c\u01A1
      quan sinh d\u1EE5c ngo\xE0i c\u1EE7a nam gi\u1EDBi?"
    answers:
    - "Tinh ho\xE0n"
    - "B\xECu v\xE0 D\u01B0\u01A1ng v\u1EADt"
    - "Tuy\u1EBFn h\xE0nh ni\u1EC7u \u0111\u1EA1o"
    - "Th\u1EEBng tinh"
    correctIndex: 1
  femaleQuestions:
  - questionKey: 6
    answerKeys:
    - 6a
    - 6b
    - 6c
    - 6d
    question: "C\xE2u 1 :Trong \u0111i\u1EC1u ki\u1EC7n b\xECnh th\u01B0\u1EDDng,
      s\u1EF1 th\u1EE5 tinh gi\u1EEFa tr\u1EE9ng v\xE0 tinh tr\xF9ng th\u01B0\u1EDDng
      di\u1EC5n ra t\u1EA1i v\u1ECB tr\xED n\xE0o c\u1EE7a v\xF2i t\u1EED cung (v\xF2i
      tr\u1EE9ng)?"
    answers:
    - "Ph\u1EC5u v\xF2i"
    - "B\xF3ng v\xF2i"
    - "Eo v\xF2i"
    - "Ph\u1EA7n t\u1EED cung c\u1EE7a v\xF2i"
    correctIndex: 1
  - questionKey: 7
    answerKeys:
    - 7a
    - 7b
    - 7c
    - 7d
    question: "C\xE2u 2 :T\u1EED cung b\xECnh th\u01B0\u1EDDng n\u1EB1m \u1EDF t\u01B0
      th\u1EBF n\xE0o trong h\u1ED1 ch\u1EADu?"
    answers:
    - "Ng\u1EA3 sau v\xE0 g\u1EA5p sau"
    - "Ng\u1EA3 tr\u01B0\u1EDBc v\xE0 g\u1EA5p tr\u01B0\u1EDBc "
    - Trung gian
    - "L\u1EC7ch tr\xE1i"
    correctIndex: 1
  - questionKey: 8
    answerKeys:
    - 8a
    - 8b
    - 8c
    - 8d
    question: "C\xE2u 3 :D\xE2y ch\u1EB1ng n\xE0o c\xF3 vai tr\xF2 ch\xEDnh trong
      vi\u1EC7c gi\u1EEF bu\u1ED3ng tr\u1EE9ng d\xEDnh v\xE0o m\u1EB7t sau c\u1EE7a
      d\xE2y ch\u1EB1ng r\u1ED9ng?"
    answers:
    - "D\xE2y ch\u1EB1ng treo bu\u1ED3ng tr\u1EE9ng"
    - "D\xE2y ch\u1EB1ng ri\xEAng bu\u1ED3ng tr\u1EE9ng"
    - "M\u1EA1c treo bu\u1ED3ng tr\u1EE9ng"
    - "D\xE2y ch\u1EB1ng tr\xF2n"
    correctIndex: 2
  - questionKey: 9
    answerKeys:
    - 9a
    - 9b
    - 9c
    - 9d
    question: "C\xE2u 4 :L\u1EDBp n\xE0o c\u1EE7a th\xE0nh t\u1EED cung s\u1EBD bong
      ra v\xE0 g\xE2y ch\u1EA3y m\xE1u trong chu k\u1EF3 kinh nguy\u1EC7t?"
